<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>GridBridge onboarding evidence</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #10233f;
      --muted: #5c6f86;
      --navy: #071b33;
      --navy-2: #0d2a4d;
      --cyan: #1bb7b3;
      --cyan-soft: #dff8f5;
      --amber: #d8901c;
      --amber-soft: #fff4dc;
      --red: #c04a5a;
      --red-soft: #fdecef;
      --green: #23866b;
      --green-soft: #e4f6ee;
      --line: #dce5ec;
      --paper: #ffffff;
      --surface: #f4f7fa;
      --shadow: 0 18px 44px rgba(7, 27, 51, .09);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--surface);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.45;
    }
    .shell { max-width: 1220px; margin: 0 auto; padding: 32px 28px 56px; }
    .hero {
      position: relative;
      overflow: hidden;
      padding: 34px 38px 32px;
      border-radius: 24px;
      background: linear-gradient(135deg, var(--navy), var(--navy-2));
      color: #fff;
      box-shadow: var(--shadow);
    }
    .hero::after {
      content: "";
      position: absolute;
      width: 360px;
      height: 360px;
      right: -120px;
      top: -190px;
      border-radius: 50%;
      border: 74px solid rgba(27, 183, 179, .16);
    }
    .eyebrow { margin: 0 0 12px; color: #8fe4dd; font-size: 12px; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; }
    h1 { max-width: 760px; margin: 0; font-size: clamp(30px, 4vw, 48px); line-height: 1.04; letter-spacing: -.035em; }
    .hero-copy { max-width: 760px; margin: 17px 0 0; color: #cbd8e6; font-size: 16px; }
    .hero-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
    .chip { border: 1px solid rgba(255,255,255,.2); border-radius: 999px; padding: 7px 11px; color: #e5edf5; font-size: 12px; }
    .notice { display: flex; gap: 12px; margin: 18px 0 0; padding: 12px 15px; border-radius: 12px; background: rgba(255,255,255,.08); color: #dbe6f0; font-size: 13px; }
    .pulse { flex: 0 0 9px; width: 9px; height: 9px; margin-top: 5px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 5px rgba(27,183,179,.15); }
    .grid { display: grid; gap: 18px; }
    .metrics { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 20px; }
    .metric, .panel { border: 1px solid var(--line); background: var(--paper); box-shadow: 0 10px 26px rgba(7,27,51,.045); }
    .metric { padding: 19px 20px; border-radius: 17px; }
    .metric-label { margin: 0; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
    .metric-value { margin: 5px 0 1px; font-size: 31px; font-weight: 760; letter-spacing: -.04em; }
    .metric-note { margin: 0; color: var(--muted); font-size: 12px; }
    .panel { margin-top: 18px; padding: 24px; border-radius: 18px; }
    .panel-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 17px; }
    .section-kicker { margin: 0 0 4px; color: var(--cyan); font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    h2 { margin: 0; font-size: 22px; letter-spacing: -.025em; }
    .section-copy { max-width: 580px; margin: 0; color: var(--muted); font-size: 13px; text-align: right; }
    .status { display: inline-flex; align-items: center; gap: 7px; border-radius: 999px; padding: 6px 10px; font-size: 12px; font-weight: 750; }
    .status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .status-success, .status-review { color: var(--green); background: var(--green-soft); }
    .status-degraded, .status-not_economic { color: #9d6309; background: var(--amber-soft); }
    .status-failed, .status-blocked { color: var(--red); background: var(--red-soft); }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th { padding: 10px 10px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 10px; letter-spacing: .08em; text-align: right; text-transform: uppercase; }
    th:first-child, td:first-child { text-align: left; }
    td { padding: 13px 10px; border-bottom: 1px solid #edf1f4; text-align: right; vertical-align: middle; }
    tbody tr:last-child td { border-bottom: 0; }
    .source-name { color: var(--ink); font-weight: 720; text-transform: capitalize; }
    .mono { font-family: "SFMono-Regular", Consolas, monospace; font-size: 11px; }
    .two-col { grid-template-columns: 1.05fr .95fr; }
    .topology-stat { display: flex; gap: 10px; margin-bottom: 15px; }
    .mini { flex: 1; padding: 12px; border-radius: 12px; background: var(--surface); }
    .mini strong { display: block; font-size: 20px; }
    .mini span { color: var(--muted); font-size: 11px; }
    .issues { margin: 0; padding: 0; list-style: none; }
    .issue { padding: 13px 14px; border-left: 3px solid var(--red); border-radius: 0 10px 10px 0; background: var(--red-soft); }
    .issue + .issue { margin-top: 8px; }
    .issue code { color: #8f3140; font-weight: 750; }
    .issue p { margin: 4px 0 0; color: #6d4250; font-size: 12px; }
    .quality-list { display: grid; gap: 11px; }
    .quality-row { display: grid; grid-template-columns: 74px 1fr 60px; gap: 11px; align-items: center; }
    .quality-row span { font-size: 12px; text-transform: capitalize; }
    .bar { overflow: hidden; height: 8px; border-radius: 999px; background: #e7edf2; }
    .bar > span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--cyan), #47d4bd); }
    .quality-row strong { font-size: 12px; text-align: right; }
    .blocked-copy { color: var(--red); font-size: 11px; }
    footer { display: flex; justify-content: space-between; gap: 20px; margin-top: 20px; padding: 0 4px; color: var(--muted); font-size: 11px; }
    @media (max-width: 820px) {
      .shell { padding: 18px 14px 36px; }
      .hero { padding: 27px 24px; border-radius: 18px; }
      .metrics, .two-col { grid-template-columns: 1fr 1fr; }
      .panel { overflow-x: auto; padding: 20px 16px; }
      .panel-head { align-items: flex-start; flex-direction: column; }
      .section-copy { text-align: left; }
    }
    @media (max-width: 540px) { .metrics, .two-col { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <main class="shell">
    <header class="hero">
      <p class="eyebrow">GridBridge / Run evidence</p>
      <h1>Utility data onboarding, reconciled end to end.</h1>
      <p class="hero-copy">Meter, GIS, SCADA, DER and market feeds mapped into a traceable canonical model with explicit exceptions and safety-gated flex advice.</p>
      <div class="hero-meta">
        <span class="status status-{{ summary.status.value }}" aria-label="Run status: {{ summary.status.value }}">{{ summary.status.value }}</span>
        <span class="chip">Run {{ summary.run_id }}</span>
        <span class="chip">{{ "%.2f"|format(duration_seconds) }}s pipeline time</span>
        <span class="chip">{{ warehouse_name }}</span>
      </div>
      <div class="notice"><span class="pulse"></span><span><strong>Synthetic portfolio demonstration.</strong> Advisory only; no field-device connection, control command or compliance certification is implied.</span></div>
    </header>

    <section class="grid metrics" aria-label="Run summary">
      <article class="metric"><p class="metric-label">Landed</p><p class="metric-value">{{ summary.total_landed }}</p><p class="metric-note">raw source records</p></article>
      <article class="metric"><p class="metric-label">Accepted</p><p class="metric-value">{{ summary.total_accepted }}</p><p class="metric-note">{{ "%.1f"|format(acceptance_rate) }}% through contracts</p></article>
      <article class="metric"><p class="metric-label">Quarantined</p><p class="metric-value">{{ summary.total_quarantined }}</p><p class="metric-note">preserved with reason codes</p></article>
      <article class="metric"><p class="metric-label">Reconciliation</p><p class="metric-value">{{ "100%" if summary.reconciliation_balanced else "Failed" }}</p><p class="metric-note">landed = accepted + rejected</p></article>
    </section>

    <section class="panel">
      <div class="panel-head"><div><p class="section-kicker">01 / Lineage</p><h2>Source reconciliation</h2></div><p class="section-copy">Every accepted and rejected row remains tied to an immutable source hash and this run ID.</p></div>
      <table>
        <thead><tr><th>Source</th><th>Landed</th><th>Accepted</th><th>Quarantined</th><th>Inserted</th><th>Updated</th><th>Unchanged</th><th>Manifest</th></tr></thead>
        <tbody>
        {% for item in summary.source_summaries %}
          <tr><td class="source-name">{{ item.source.value }}</td><td>{{ item.landed }}</td><td>{{ item.accepted }}</td><td>{{ item.quarantined }}</td><td>{{ item.inserted }}</td><td>{{ item.updated }}</td><td>{{ item.unchanged }}</td><td class="mono">{{ item.manifest_sha256[:10] }}…</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </section>

    <section class="grid two-col">
      <article class="panel">
        <div class="panel-head"><div><p class="section-kicker">02 / Network</p><h2>Topology findings</h2></div></div>
        <div class="topology-stat"><div class="mini"><strong>{{ summary.topology.energized_nodes }}</strong><span>energized nodes</span></div><div class="mini"><strong>{{ summary.topology.energized_edges }}</strong><span>energized edges</span></div></div>
        {% if summary.topology.issues %}
        <ul class="issues">
          {% for issue in summary.topology.issues %}
          <li class="issue"><code>{{ issue.code }}</code><p>{{ issue.detail }}{% if issue.asset_id %} · {{ issue.asset_id }}{% endif %}</p></li>
          {% endfor %}
        </ul>
        {% else %}<span class="status status-success">Topology valid</span>{% endif %}
      </article>

      <article class="panel">
        <div class="panel-head"><div><p class="section-kicker">03 / Quality</p><h2>Acceptance by source</h2></div></div>
        <div class="quality-list">
          {% for item in summary.source_summaries %}
          <div class="quality-row"><span>{{ item.source.value }}</span><div class="bar"><span style="width: {{ (item.accepted / item.landed * 100) if item.landed else 0 }}%"></span></div><strong>{{ "%.1f"|format((item.accepted / item.landed * 100) if item.landed else 0) }}%</strong></div>
          {% endfor %}
        </div>
      </article>
    </section>

    <section class="panel">
      <div class="panel-head"><div><p class="section-kicker">04 / Operations</p><h2>Flex advisory</h2></div><p class="section-copy">Candidates are explanatory review prompts. Any failed topology, freshness or capacity gate blocks advice.</p></div>
      <table>
        <thead><tr><th>Feeder</th><th>Interval UTC</th><th>Status</th><th>Price A$/MWh</th><th>Eligible DER kW</th><th>Headroom kW</th><th>Advisory kW</th><th>Evidence</th></tr></thead>
        <tbody>
        {% for item in summary.flex_recommendations %}
          <tr><td class="source-name">{{ item.feeder_id }}</td><td class="mono">{{ item.interval_start_utc.isoformat() }}</td><td><span class="status status-{{ item.status }}">{{ item.status|replace('_', ' ') }}</span></td><td>{{ "%.2f"|format(item.factors.market_price_aud_per_mwh) }}</td><td>{{ "%.1f"|format(item.factors.eligible_der_kw) }}</td><td>{{ "%.1f"|format(item.factors.transformer_headroom_kw) }}</td><td>{{ "%.1f"|format(item.advisory_kw) }}</td><td class="blocked-copy">{{ item.block_reasons|join(', ') if item.block_reasons else "human review required" }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </section>

    <footer><span>Generated by GridBridge · deterministic synthetic data</span><span>dbt {{ "passed" if summary.dbt_success else "failed" }} · no remote assets or tracking</span></footer>
  </main>
</body>
</html>

